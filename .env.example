DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/clearing_hub
# 관리 API(/admin/*) 헤더 X-Admin-Token 값. 32자 이상
ADMIN_TOKEN=
DB_ECHO=false
# 허브 → 은행 호출 타임아웃(초), 미확인 거래 재시도 간격(초)·횟수
RECEIVER_TIMEOUT_SECONDS=5
RETRY_INTERVAL_SECONDS=60
RETRY_MAX_COUNT=10
# 1회 이체 상한(원)
MAX_TRANSFER_AMOUNT=100000000
# 정산 (docs/SETTLEMENT_PLAN.md): 일일 배치 태스크를 띄울지, 매일 마감 배치 시각(HH:MM), 기준 시간대,
# 대사 없이 자동 확정할지(시연용. false면 관리자가 POST /admin/settlements/{run_id}/confirm)
SETTLEMENT_WORKER_ENABLED=true
SETTLEMENT_CUTOFF_TIME=00:05
SETTLEMENT_TIMEZONE=Asia/Seoul
SETTLEMENT_AUTO_CONFIRM=false
# 서명 (SPEC 2절, Ed25519만): 허브 Ed25519 개인키 (raw 32바이트 base64, 44자). **필수** (없으면 서버가 시작하지 않는다)
# 만들기: uv run python -c "from clearing_hub.core.signing import generate_keypair; print(generate_keypair())"
#   → (개인키, 공개키). 개인키만 여기에 넣는다. 공개키는 GET /v1/hub-key로 나가고, 그 지문(fingerprint)을 은행마다 따로 알려 준다
HUB_SIGNING_KEY=
# 은행 공개키 회전 뒤 옛 키를 받아 주는 시간(초)
PREVIOUS_KEY_TTL_SECONDS=86400
# 셀프 등록 (SPEC 3.5, docs/ONBOARDING.md): 초대 코드 유효 기간(일), 자동 배정을 시작할 은행 코드, 새 은행의 순채무한도(원)
INVITE_TTL_DAYS=7
BANK_CODE_START=903
DEFAULT_NET_DEBIT_CAP=1000000000
# 초대 문구(POST /admin/invites의 message)에 넣을 허브 주소. 비어 있으면 그 요청의 주소
HUB_PUBLIC_URL=
